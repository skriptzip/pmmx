# Überschreibt Werte aus config.yaml via Umgebungsvariablen.
# Verschachtelte Keys nutzen doppelten Unterstrich als Trennzeichen.

# Hostname, unter dem Traefik die App ausliefert (HTTPS macht Traefik).
DOMAIN=pmmx.example.com
# Optional, Defaults in Klammern: Name des Traefik-Docker-Netzwerks (traefik),
# Entrypoint (websecure), Cert-Resolver (letsencrypt).
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# Pflicht. Erzeugen mit: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
SECRET_KEY=generate-a-random-64-char-string

TMDB__API_KEY=your_tmdb_api_key_here

# Nur diese Plex-Nutzer (Benutzername oder E-Mail, kommagetrennt) dürfen sich anmelden.
# Leer = jeder Plex-Nutzer. Für öffentliche Server unbedingt setzen.
AUTH__ALLOWED_USERS=dein-plex-name

STREAMING__API_KEY=your_watchmode_api_key_here

# Notifications
NOTIFICATIONS__NTFY_TOPIC=plex-missing-media
# NOTIFICATIONS__DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# NOTIFICATIONS__PUSHOVER_TOKEN=...

# Plex-Credentials gehören NICHT hierher.
# Jeder Nutzer meldet sich über den OAuth-Flow an (POST /auth/plex/pin).
