{
  "name": "pmmx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "pnpm build && cap sync",
    "cap:copy": "pnpm build && cap copy",
    "android:open": "cap open android",
    "android:run": "pnpm build && cap sync android && cap run android",
    "android:live": "cap run android -l --external",
    "android:debug": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "pnpm build && cap sync android && cd android && gradlew.bat assembleRelease",
    "android:bundle": "pnpm build && cap sync android && cd android && gradlew.bat bundleRelease",
    "android:clean": "cd android && gradlew.bat clean",
    "ios:open": "cap open ios",
    "ios:run": "pnpm build && cap sync ios && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@tanstack/react-query": "^5.0.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.5.0",
    "vite": "^6.4.5"
  }
}
